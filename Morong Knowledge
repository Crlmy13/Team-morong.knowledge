<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Morong, Rizal - Official Knowledge & DRRM Portal</title>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .tab-content {
      display: none;
      animation: fadeIn 0.25s ease-in-out forwards;
    }

    .tab-content.active {
      display: block;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(5px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .modal-anim {
      animation: modalScale 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes modalScale {
      from { opacity: 0; transform: scale(0.96); }
      to { opacity: 1; transform: scale(1); }
    }
  </style>
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen flex flex-col antialiased">

  <!-- ================================================================= -->
  <!-- 1. AUTHENTICATION SCREEN (LOGIN / SIGN UP) -->
  <!-- ================================================================= -->
  <div id="auth-screen" class="fixed inset-0 z-50 bg-slate-900 flex items-center justify-center p-4 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-blue-900 via-slate-900 to-black">
    <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-8 border border-slate-700/50 relative overflow-hidden">
      
      <!-- Brand Header -->
      <div class="text-center mb-8 space-y-2">
        <div class="inline-flex items-center justify-center w-14 h-14 bg-blue-600 text-white font-black text-2xl rounded-2xl shadow-lg shadow-blue-500/30 mb-2">
          M
        </div>
        <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Morong Knowledge Hub</h1>
        <p class="text-xs text-slate-500 font-medium">Municipality of Morong, Province of Rizal</p>
      </div>

      <!-- Auth Sub-tabs -->
      <div class="flex bg-slate-100 p-1 rounded-xl mb-6 text-xs font-bold">
        <button id="tab-login-btn" onclick="switchAuthTab('login')" class="flex-1 py-2.5 rounded-lg bg-white text-blue-600 shadow-sm transition-all">Log In</button>
        <button id="tab-signup-btn" onclick="switchAuthTab('signup')" class="flex-1 py-2.5 rounded-lg text-slate-500 hover:text-slate-800 transition-all">Sign Up</button>
      </div>

      <!-- FORM 1: LOGIN -->
      <form id="login-form" onsubmit="handleAuthSubmit(event, 'login')" class="space-y-4">
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Email Address</label>
          <input type="email" required placeholder="resident@morong.gov.ph" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all">
        </div>
        <div>
          <div class="flex justify-between items-center mb-1">
            <label class="text-xs font-bold uppercase tracking-wider text-slate-600">Password</label>
            <a href="#" class="text-[11px] font-semibold text-blue-600 hover:underline">Forgot password?</a>
          </div>
          <input type="password" required placeholder="••••••••" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all">
        </div>
        <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs uppercase tracking-wider py-3.5 rounded-xl shadow-lg shadow-blue-600/30 transition-all transform active:scale-[0.99]">
          LOG IN &rarr;
        </button>
      </form>

      <!-- FORM 2: SIGN UP -->
      <form id="signup-form" onsubmit="handleAuthSubmit(event, 'signup')" class="space-y-4 hidden">
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Full Name</label>
          <input type="text" required placeholder="Juan Dela Cruz" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all">
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Email Address</label>
          <input type="email" required placeholder="juan@example.com" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all">
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Barangay in Morong</label>
          <select required class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all">
            <option value="">Select Barangay</option>
            <option value="Bombongan">Barangay Bombongan</option>
            <option value="Can-Cal-Lan">Barangay Can-Cal-Lan</option>
            <option value="Lagundi">Barangay Lagundi</option>
            <option value="Maybancal">Barangay Maybancal</option>
            <option value="San Guillermo">Barangay San Guillermo</option>
            <option value="San Jose">Barangay San Jose (Poblacion)</option>
            <option value="San Juan">Barangay San Juan (Poblacion)</option>
            <option value="San Pedro">Barangay San Pedro (Poblacion)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Password</label>
          <input type="password" required placeholder="••••••••" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all">
        </div>
        <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs uppercase tracking-wider py-3.5 rounded-xl shadow-lg shadow-emerald-600/30 transition-all transform active:scale-[0.99]">
          Create Account &rarr;
        </button>
      </form>

      <div class="mt-6 text-center">
        <p class="text-[11px] text-slate-400">Official Portal of Morong, Rizal</p>
      </div>
    </div>
  </div>


  <!-- ================================================================= -->
  <!-- 2. MAIN APP DASHBOARD -->
  <!-- ================================================================= -->
  <div id="app-dashboard" class="hidden flex-col min-h-screen">

    <!-- TOP NAVIGATION BAR -->
    <header class="bg-slate-900 text-white sticky top-0 z-40 shadow-xl border-b border-slate-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        
        <!-- Brand Logo -->
        <div class="flex items-center space-x-3 cursor-pointer" onclick="switchMainTab('history')">
          <div class="bg-blue-600 text-white font-black text-xl w-10 h-10 rounded-xl flex items-center justify-center shadow-md">
            M
          </div>
          <div>
            <h1 class="font-extrabold text-base leading-tight tracking-tight text-white">Morong Knowledge Hub</h1>
            <p class="text-[10px] text-slate-400 font-medium uppercase tracking-wider">Province of Rizal</p>
          </div>
        </div>

        <!-- Desktop Tab Navigation -->
        <nav class="hidden md:flex items-center space-x-1 lg:space-x-2 text-xs font-bold">
          <button onclick="switchMainTab('history')" id="nav-history" class="nav-btn px-3 py-2.5 rounded-xl text-blue-400 bg-blue-950/60 transition-all flex items-center space-x-1.5">
            <span>🏛️</span> <span>History & Culture</span>
          </button>
          <button onclick="switchMainTab('drrm')" id="nav-drrm" class="nav-btn px-3 py-2.5 rounded-xl text-slate-300 hover:text-white hover:bg-slate-800 transition-all flex items-center space-x-1.5">
            <span>🛡️</span> <span>DRRM & Evacuation</span>
          </button>
          <button onclick="switchMainTab('preparedness')" id="nav-preparedness" class="nav-btn px-3 py-2.5 rounded-xl text-slate-300 hover:text-white hover:bg-slate-800 transition-all flex items-center space-x-1.5">
            <span>⚠️</span> <span>Disaster Preparedness</span>
          </button>
          <button onclick="switchMainTab('directory')" id="nav-directory" class="nav-btn px-3 py-2.5 rounded-xl text-slate-300 hover:text-white hover:bg-slate-800 transition-all flex items-center space-x-1.5">
            <span>📞</span> <span>Emergency Directory</span>
          </button>
          <button onclick="switchMainTab('quiz')" id="nav-quiz" class="nav-btn px-3 py-2.5 rounded-xl text-slate-300 hover:text-white hover:bg-slate-800 transition-all flex items-center space-x-1.5">
            <span>🧠</span> <span>Knowledge Assessment</span>
          </button>
        </nav>

        <!-- User Profile, Settings Button & Logout -->
        <div class="flex items-center space-x-3">
          <div class="hidden sm:flex flex-col text-right">
            <span id="user-display-name" class="text-xs font-bold text-slate-100">Morong Resident</span>
            <span class="text-[10px] text-emerald-400 font-medium">● Online</span>
          </div>
          <!-- SETTINGS BUTTON FOR RESIDENCE -->
          <button onclick="openSettingsModal()" class="bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-bold text-xs px-3 py-2 rounded-xl transition-all flex items-center space-x-1">
            <span>⚙️ Settings</span>
          </button>
          <button onclick="logout()" class="bg-slate-800 hover:bg-red-600/20 hover:text-red-400 text-slate-300 border border-slate-700 font-bold text-xs px-3 py-2 rounded-xl transition-all flex items-center space-x-1">
            <span>Log out</span>
          </button>
        </div>

      </div>

      <!-- Mobile Nav Bar -->
      <div class="md:hidden flex overflow-x-auto px-4 py-2 bg-slate-950 border-t border-slate-800 space-x-2 text-xs font-bold no-scrollbar">
        <button onclick="switchMainTab('history')" id="mobile-nav-history" class="mobile-nav-btn px-3 py-2 rounded-lg bg-blue-600 text-white whitespace-nowrap">History & Culture</button>
        <button onclick="switchMainTab('drrm')" id="mobile-nav-drrm" class="mobile-nav-btn px-3 py-2 rounded-lg bg-slate-800 text-slate-300 whitespace-nowrap">DRRM</button>
        <button onclick="switchMainTab('preparedness')" id="mobile-nav-preparedness" class="mobile-nav-btn px-3 py-2 rounded-lg bg-slate-800 text-slate-300 whitespace-nowrap">Preparedness</button>
        <button onclick="switchMainTab('directory')" id="mobile-nav-directory" class="mobile-nav-btn px-3 py-2 rounded-lg bg-slate-800 text-slate-300 whitespace-nowrap">Directory</button>
        <button onclick="switchMainTab('quiz')" id="mobile-nav-quiz" class="mobile-nav-btn px-3 py-2 rounded-lg bg-slate-800 text-slate-300 whitespace-nowrap">Quiz</button>
      </div>
    </header>


    <!-- ================================================================= -->
    <!-- 3. DYNAMIC CONTENT AREA -->
    <!-- ================================================================= -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">

      <!-- ================= TAB 1: HISTORY & CULTURE ================= -->
      <section id="view-history" class="tab-content active space-y-6">
        <div class="bg-white p-6 sm:p-8 rounded-2xl border border-slate-200/80 shadow-sm flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4">
          <div>
            <span class="text-blue-600 font-extrabold text-xs tracking-wider uppercase">MORONG, RIZAL HERITAGE</span>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mt-1">History, Culture & Local Destinations</h2>
            <p class="text-slate-500 text-sm mt-1">Explore Morong's timeline, heritage, tourist spots, restaurants, cafés, and barangays.</p>
          </div>
          
          <!-- FILTER BUTTONS -->
          <div class="flex flex-wrap gap-1.5 text-xs font-bold bg-slate-50 p-1.5 rounded-2xl border border-slate-200">
            <button onclick="filterHistory('all', this)" class="hist-filter-btn px-3.5 py-2 rounded-xl bg-blue-600 text-white shadow-sm transition-all">All</button>
            <button onclick="filterHistory('timeline', this)" class="hist-filter-btn px-3.5 py-2 rounded-xl text-slate-600 hover:text-slate-900 transition-all">Timeline</button>
            <button onclick="filterHistory('history', this)" class="hist-filter-btn px-3.5 py-2 rounded-xl text-slate-600 hover:text-slate-900 transition-all">History</button>
            <button onclick="filterHistory('culture', this)" class="hist-filter-btn px-3.5 py-2 rounded-xl text-slate-600 hover:text-slate-900 transition-all">Culture</button>
            <button onclick="filterHistory('tourist-spot', this)" class="hist-filter-btn px-3.5 py-2 rounded-xl text-slate-600 hover:text-slate-900 transition-all">Tourist Spot</button>
            <button onclick="filterHistory('dining', this)" class="hist-filter-btn px-3.5 py-2 rounded-xl text-slate-600 hover:text-slate-900 transition-all">Restaurants & Cafés</button>
            <button onclick="filterHistory('barangay', this)" class="hist-filter-btn px-3.5 py-2 rounded-xl text-slate-600 hover:text-slate-900 transition-all">Barangay</button>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="history-cards-grid">
          <!-- Dynamically Injected -->
        </div>
      </section>


      <!-- ================= TAB 2: DRRM & EVACUATION ================= -->
      <section id="view-drrm" class="tab-content space-y-6">
        <div class="bg-gradient-to-r from-slate-900 to-blue-950 text-white p-6 sm:p-8 rounded-2xl shadow-md border border-slate-800">
          <span class="bg-red-500/20 text-red-400 border border-red-500/30 text-[10px] font-black uppercase tracking-widest px-3 py-1 rounded-full">DISASTER RISK REDUCTION</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight mt-2">Disaster Preparedness & Evacuation Centers</h2>
          <p class="text-slate-300 text-sm mt-1 max-w-2xl">Safety guides and official Evacuation Center listings for the 8 barangays of Morong, Rizal.</p>
        </div>

        <!-- Evacuation Table -->
        <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6">
          <h3 class="font-extrabold text-lg text-slate-900 mb-4 flex items-center">
            <span class="mr-2">📍</span> Evacuation Centers per Barangay (Morong, Rizal)
          </h3>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs sm:text-sm">
              <thead>
                <tr class="bg-slate-50 border-b border-slate-200 text-slate-600 font-bold uppercase tracking-wider text-[11px]">
                  <th class="py-3.5 px-4 rounded-l-lg">Barangay</th>
                  <th class="py-3.5 px-4">Evacuation Center / Facility</th>
                  <th class="py-3.5 px-4">Capacity</th>
                  <th class="py-3.5 px-4">MDRRMO Contact</th>
                  <th class="py-3.5 px-4 rounded-r-lg">Status</th>
                </tr>
              </thead>
              <tbody id="evac-table-body" class="divide-y divide-slate-100">
                <!-- Dynamically Injected -->
              </tbody>
            </table>
          </div>
        </div>
      </section>


      <!-- ================= TAB 3: DISASTER PREPAREDNESS TAB ================= -->
      <section id="view-preparedness" class="tab-content space-y-6">
        <div class="bg-gradient-to-r from-amber-600 to-orange-700 text-white p-6 sm:p-8 rounded-2xl shadow-md">
          <span class="bg-white/20 text-white text-[10px] font-black uppercase tracking-widest px-3 py-1 rounded-full">WEATHER & SAFETY MONITOR</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight mt-2">Disaster Preparedness & Weather Advisories</h2>
          <p class="text-amber-100 text-sm mt-1 max-w-2xl">Kasalukuyang lagay ng panahon, mga babala sa bagyo, at mga gabay sa paghahanda para sa mamamayan ng Morong.</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6 space-y-4">
            <div class="flex items-center justify-between border-b pb-3">
              <div class="flex items-center space-x-2">
                <span class="text-2xl">🌀</span>
                <div>
                  <h3 class="font-extrabold text-base text-slate-900">Active Weather Advisory & Tropical Cyclone Bulletin</h3>
                  <p class="text-xs text-slate-500">PAGASA Update for Rizal & Southern Luzon Region</p>
                </div>
              </div>
              <span class="bg-amber-100 text-amber-800 text-[10px] font-black px-2.5 py-1 rounded-full uppercase">Signal No. 1 Warning</span>
            </div>

            <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-xs text-amber-900 space-y-2">
              <p class="font-bold">⚠ Babala sa Bagyo / Low Pressure Area (LPA):</p>
              <p>Inaabisuhan ang lahat ng residente ng Morong, lalo na ang mga malapit sa Laguna de Bay at mga tabing-ilog sa Bombongan at San Jose, na mag-ingat sa posibleng pagbaha at pagguho ng lupa dulot ng katamtaman hanggang malakas na pag-ulan.</p>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-2 text-center text-xs">
              <div class="bg-slate-50 p-3 rounded-xl border border-slate-100">
                <span class="block text-slate-400 text-[10px] font-bold">WIND SPEED</span>
                <span class="font-extrabold text-slate-800 text-sm">45 - 60 km/h</span>
              </div>
              <div class="bg-slate-50 p-3 rounded-xl border border-slate-100">
                <span class="block text-slate-400 text-[10px] font-bold">RAINFALL</span>
                <span class="font-extrabold text-slate-800 text-sm">Moderate-Heavy</span>
              </div>
              <div class="bg-slate-50 p-3 rounded-xl border border-slate-100">
                <span class="block text-slate-400 text-[10px] font-bold">DAM LEVEL</span>
                <span class="font-extrabold text-slate-800 text-sm">Normal Range</span>
              </div>
              <div class="bg-slate-50 p-3 rounded-xl border border-slate-100">
                <span class="block text-slate-400 text-[10px] font-bold">ALERT LEVEL</span>
                <span class="font-extrabold text-amber-600 text-sm">YELLOW ALERT</span>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6 space-y-4">
            <h3 class="font-extrabold text-base text-slate-900 flex items-center">
              <span class="mr-2">🎒</span> Emergency Go Bag Checklist
            </h3>
            <p class="text-xs text-slate-500">Ihanda ang mga sumusunod na gamit sa isang bag na madaling bitbitin:</p>
            <ul class="text-xs space-y-2 text-slate-700">
              <li class="flex items-center space-x-2"><span class="text-emerald-500">✓</span> <span>Tubig na maiinom (good for 3 days)</span></li>
              <li class="flex items-center space-x-2"><span class="text-emerald-500">✓</span> <span>Pagkaing hindi madaling mapanis (canned goods)</span></li>
              <li class="flex items-center space-x-2"><span class="text-emerald-500">✓</span> <span>First Aid Kit & Maintenance Medicines</span></li>
              <li class="flex items-center space-x-2"><span class="text-emerald-500">✓</span> <span>Flashlight, Powerbank & Ekstra Batarya</span></li>
              <li class="flex items-center space-x-2"><span class="text-emerald-500">✓</span> <span>Pito (Whistle) & Mahahalagang Dokumento</span></li>
              <li class="flex items-center space-x-2"><span class="text-emerald-500">✓</span> <span>Ekstrang Damit & Raincoat</span></li>
            </ul>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm space-y-2">
            <div class="text-blue-600 font-extrabold text-xs">STEP 1</div>
            <h4 class="font-extrabold text-base text-slate-900">Bago ang Bagyo (Before)</h4>
            <ul class="text-xs text-slate-600 space-y-1.5 list-disc pl-4">
              <li>I-check ang bubong at pundasyon ng bahay.</li>
              <li>Makinig sa opisyal na balita mula sa MDRRMO Morong.</li>
              <li>Icharge ang mga cellphone at powerbank.</li>
            </ul>
          </div>

          <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm space-y-2">
            <div class="text-amber-600 font-extrabold text-xs">STEP 2</div>
            <h4 class="font-extrabold text-base text-slate-900">Habang May Bagyo (During)</h4>
            <ul class="text-xs text-slate-600 space-y-1.5 list-disc pl-4">
              <li>Manatili sa loob ng bahay o evacuation center.</li>
              <li>Patayin ang main switch ng kuryente kung tumataas ang baha.</li>
              <li>Iwasang lumusong sa tubig-baha.</li>
            </ul>
          </div>

          <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm space-y-2">
            <div class="text-emerald-600 font-extrabold text-xs">STEP 3</div>
            <h4 class="font-extrabold text-base text-slate-900">Pagkatapos ng Bagyo (After)</h4>
            <ul class="text-xs text-slate-600 space-y-1.5 list-disc pl-4">
              <li>Siguraduhing ligtas ang bahay bago bumalik mula sa evacuation site.</li>
              <li>Mag-ingat sa mga naputol na kable ng kuryente.</li>
              <li>Iulat ang mga pinsala sa inyong Barangay Hall.</li>
            </ul>
          </div>
        </div>
      </section>


      <!-- ================= TAB 4: EMERGENCY DIRECTORY ================= -->
      <section id="view-directory" class="tab-content space-y-6">
        <div class="bg-white p-6 sm:p-8 rounded-2xl border border-slate-200/80 shadow-sm">
          <span class="text-emerald-600 font-extrabold text-xs tracking-wider uppercase">24/7 HOTLINES</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mt-1">Emergency Hotlines Directory</h2>
          <p class="text-slate-500 text-sm mt-1">Direct phone numbers for MDRRMO Morong, PNP Station, BFP, and local hospitals.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="directory-grid">
          <!-- Dynamically Injected -->
        </div>
      </section>


      <!-- ================= TAB 5: KNOWLEDGE ASSESSMENT ================= -->
      <section id="view-quiz" class="tab-content space-y-6">
        <div class="bg-blue-900 text-white p-6 sm:p-8 rounded-2xl shadow-md border border-blue-800 text-center max-w-3xl mx-auto">
          <span class="bg-blue-800 text-blue-200 text-[10px] font-black uppercase tracking-widest px-3 py-1 rounded-full">INTERACTIVE ASSESSMENT</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight mt-2">Morong History & DRRM Quiz</h2>
          <p class="text-blue-200 text-sm mt-1">Test your knowledge about the local history, traditions, and safety guidelines in Morong.</p>
        </div>

        <div class="max-w-2xl mx-auto bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-xl">
