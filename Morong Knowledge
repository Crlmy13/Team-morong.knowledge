    /* --- HISTORY / DESTINATIONS RENDER LOGIC --- */
    function renderHistoryCards(category) {
      const container = document.getElementById('history-cards-grid');
      if (!container) return;

      container.innerHTML = '';
      const filtered = category === 'all' 
        ? HISTORY_DATA 
        : HISTORY_DATA.filter(item => item.category === category);

      if (filtered.length === 0) {
        container.innerHTML = `<div class="col-span-full text-center py-12 text-slate-400 font-medium">No items found for this category.</div>`;
        return;
      }

      filtered.forEach(item => {
        let badgeColor = 'bg-blue-600';
        if (item.category === 'history') badgeColor = 'bg-indigo-600';
        if (item.category === 'culture') badgeColor = 'bg-amber-600';
        if (item.category === 'timeline') badgeColor = 'bg-emerald-600';
        if (item.category === 'tourist-spot') badgeColor = 'bg-purple-600';
        if (item.category === 'dining') badgeColor = 'bg-orange-600';
        if (item.category === 'barangay') badgeColor = 'bg-rose-600';
        
        const mediaContent = item.useSvg 
          ? CHURCH_AI_SVG 
          : `<img src="${item.image}" alt="${item.title}" class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1548625361-188b8e0193e7?auto=format&fit=crop&w=800&q=80';">`;

        const card = `
          <div onclick="openModal('${item.id}')" class="bg-white rounded-2xl border border-slate-200/80 overflow-hidden shadow-sm hover:shadow-md transition-all flex flex-col cursor-pointer group">
            <div class="h-48 bg-slate-900 relative overflow-hidden flex items-center justify-center">
              ${mediaContent}
              <span class="absolute top-3 left-3 ${badgeColor} text-white text-[10px] font-extrabold uppercase tracking-widest px-2.5 py-1 rounded-md shadow-sm z-10">${item.categoryLabel}</span>
            </div>
            <div class="p-5 flex-grow flex flex-col justify-between space-y-3">
              <div>
                <h3 class="font-extrabold text-lg text-slate-900 leading-snug group-hover:text-blue-600 transition-colors">${item.title}</h3>
                <p class="text-xs text-slate-500 mt-1.5 leading-relaxed">${item.shortDesc}</p>
              </div>
              <span class="text-xs font-bold text-blue-600 pt-2 flex items-center">
                Read More &rarr;
              </span>
            </div>
          </div>
        `;
        container.insertAdjacentHTML('beforeend', card);
      });
    }

    function filterHistory(cat, targetBtn) {
      const btns = document.querySelectorAll('.hist-filter-btn');
      btns.forEach(btn => {
        btn.className = 'hist-filter-btn px-3.5 py-2 rounded-xl text-slate-600 hover:text-slate-900 transition-all';
