      DIRECTORY_DATA.forEach(item => {
        const card = `
          <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm space-y-3 hover:border-blue-400 transition-all">
            <div class="flex items-center justify-between">
              <span class="text-3xl">${item.icon}</span>
              <span class="bg-blue-50 text-blue-700 text-[10px] font-bold px-2.5 py-1 rounded-lg border border-blue-200/50">${item.badge}</span>
            </div>
            <div>
              <h3 class="font-extrabold text-base text-slate-900">${item.title}</h3>
              <p class="text-xs text-slate-500 mt-1">${item.desc}</p>
            </div>
            <div class="pt-3 border-t border-slate-100">
              <a href="tel:${item.number}" class="text-sm font-extrabold text-blue-600 hover:underline font-mono block">${item.number}</a>
            </div>
          </div>
        `;
        container.insertAdjacentHTML('beforeend', card);
      });
    }


    /* --- QUIZ LOGIC --- */
    let currentQuizIndex = 0;
    let quizScore = 0;
    let shuffledOptions = [];

    function shuffleArray(array) {
      let arr = [...array];
      for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
      }
      return arr;
    }

    function renderQuizQuestion() {
      const q = QUIZ_QUESTIONS[currentQuizIndex];
      const progressEl = document.getElementById('quiz-progress-text');
      const scoreEl = document.getElementById('quiz-score-text');
      const questionEl = document.getElementById('quiz-question-title');
      const optionsContainer = document.getElementById('quiz-options-container');

      if (!q || !optionsContainer) return;

      progressEl.textContent = `Question ${currentQuizIndex + 1} of ${QUIZ_QUESTIONS.length}`;
      scoreEl.textContent = `Score: ${quizScore}`;
      questionEl.textContent = q.question;
      optionsContainer.innerHTML = '';

      shuffledOptions = shuffleArray(q.options);

      shuffledOptions.forEach((opt) => {
        const btn = document.createElement('button');
        btn.className = 'w-full text-left p-4 rounded-xl border border-slate-200 text-sm font-semibold hover:bg-slate-50 transition-all flex items-center justify-between';
        btn.innerHTML = `<span>${opt}</span><span class="opt-icon text-slate-300">⚪</span>`;
        btn.onclick = () => selectQuizOption(opt, btn);
        optionsContainer.appendChild(btn);
      });
    }

    function selectQuizOption(selectedOption, selectedBtn) {
      const q = QUIZ_QUESTIONS[currentQuizIndex];
      const optionsContainer = document.getElementById('quiz-options-container');
      const buttons = optionsContainer.querySelectorAll('button');

      buttons.forEach(btn => btn.disabled = true);
      const pointsPerQuestion = 100 / QUIZ_QUESTIONS.length;

      if (selectedOption === q.correct) {
        quizScore += pointsPerQuestion;
        selectedBtn.classList.add('bg-emerald-50', 'border-emerald-500', 'text-emerald-900');
        selectedBtn.querySelector('.opt-icon').textContent = '✅';
      } else {
        selectedBtn.classList.add('bg-red-50', 'border-red-500', 'text-red-900');
        selectedBtn.querySelector('.opt-icon').textContent = '❌';
        
        buttons.forEach(btn => {
          if (btn.querySelector('span').textContent === q.correct) {
            btn.classList.add('bg-emerald-50', 'border-emerald-500', 'text-emerald-900');
            btn.querySelector('.opt-icon').textContent = '✅';
          }
        });
      }

      const exp = document.createElement('div');
      exp.className = 'text-xs text-slate-600 bg-slate-50 p-3.5 rounded-xl border border-slate-200 mt-3';
      exp.innerHTML = `<strong>Explanation:</strong> ${q.explanation}`;
      optionsContainer.appendChild(exp);

      document.getElementById('quiz-score-text').textContent = `Score: ${quizScore}`;
      document.getElementById('quiz-next-btn').classList.remove('hidden');
    }

    function nextQuizQuestion() {
      currentQuizIndex++;
      const nextBtn = document.getElementById('quiz-next-btn');

      if (currentQuizIndex < QUIZ_QUESTIONS.length) {
        renderQuizQuestion();
        nextBtn.classList.add('hidden');
      } else {
        renderQuizFinish();
      }
    }

    function renderQuizFinish() {
      const content = document.getElementById('quiz-card-content');
      document.getElementById('quiz-next-btn').classList.add('hidden');
      document.getElementById('quiz-progress-text').textContent = 'Completed!';

      content.innerHTML = `
        <div class="text-center py-8 space-y-4">
          <div class="text-5xl">🏆</div>
          <h3 class="text-2xl font-black text-slate-900">Quiz Completed!</h3>
          <p class="text-sm text-slate-600">Great job! Your final score is <span class="font-extrabold text-blue-600 text-xl">${quizScore} / 100</span>.</p>
          <button onclick="restartQuiz()" class="bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs uppercase tracking-wider px-6 py-3 rounded-xl shadow-md transition-all transform active:scale-95">
            ↺ Retake Quiz
          </button>
        </div>
      `;
    }

    function restartQuiz() {
      currentQuizIndex = 0;
      quizScore = 0;

      const content = document.getElementById('quiz-card-content');
      content.innerHTML = `
        <h3 id="quiz-question-title" class="text-lg font-extrabold text-slate-900 leading-snug">Loading question...</h3>
        <div id="quiz-options-container" class="space-y-3"></div>
      `;

      renderQuizQuestion();
    }


    /* --- MODAL LOGIC --- */
    function openModal(id) {
      const item = HISTORY_DATA.find(h => h.id === id);
      if (!item) return;

      const mediaSlot = document.getElementById('modal-media-slot');
      if (item.useSvg) {
        mediaSlot.innerHTML = CHURCH_AI_SVG;
      } else {
        mediaSlot.innerHTML = `<img src="${item.image}" alt="${item.title}" class="w-full h-full object-cover object-center">`;
      }

      document.getElementById('modal-category').textContent = item.categoryLabel;
      document.getElementById('modal-title').textContent = item.title;
      document.getElementById('modal-description').textContent = item.fullDesc;
      document.getElementById('modal-extra').innerHTML = `<strong>Record Details:</strong> ${item.details}`;

      document.getElementById('item-modal').classList.remove('hidden');
    }

    function closeModal() {
      document.getElementById('item-modal').classList.add('hidden');
    }
  </script>
</body>
</html>
